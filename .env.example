# Application
APP_ENV=development
APP_PORT=3000

# Database (either DATABASE_URL, or the discrete DB_* parts)
DATABASE_URL=postgresql://user:password@localhost:5432/masjid_display
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=disable

# JWT
JWT_SECRET=change-me-to-a-strong-random-secret-min-32-chars
JWT_EXPIRE_HOUR=24

# Admin (punyakuId shared-secret header) — required, no default fallback
PUNYAKU_ID_SECRET=change-me-to-a-strong-random-secret

# MyQuran API (prayer schedule provider)
MYQURAN_BASE_URL=https://api.myquran.com/v3

# CORS — comma-separated list of allowed origins, or * for all
CORS_ORIGIN=http://localhost:3001

# Trust X-Forwarded-For for rate limiting (set true only behind a trusted reverse proxy)
TRUST_PROXY=false

# Supabase Storage (file media uploads) — bare project domain, no /storage/v1 suffix
# (the app appends /storage/v1 itself, matching v1's convention)
SUPABASE_STORAGE_ENDPOINT=https://your-project.supabase.co
SUPABASE_STORAGE_BUCKET=masjid_display_bg
SUPABASE_STORAGE_SECRET_KEY=
SUPABASE_STORAGE_MAX_FILE_SIZE=1048576
